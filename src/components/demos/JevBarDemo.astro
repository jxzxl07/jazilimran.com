---
// JevBar's own policy function, ported to run here. The same one guards the
// agent on every page of this site.
const cases = [
  { verb: 'click', name: 'Next', task: 'jobApplication' },
  { verb: 'click', name: 'Save draft', task: 'jobApplication' },
  { verb: 'click', name: 'Submit application', task: 'jobApplication' },
  { verb: 'click', name: 'Resend code', task: 'general' },
  { verb: 'click', name: 'Send', task: 'general' },
  { verb: 'typeText', name: 'Password', task: 'general' },
];
---

<div class="demo jb" id="jb">
  <div class="demo-bar">
    <span class="live">Live · JevBar’s policy, running in your browser</span>
    <span class="spacer"></span>
    <span class="sig">authorize(action, task)</span>
  </div>
  <div class="video">
    <video src="/media/jevbar.mp4" poster="/media/jevbar-poster.jpg" controls preload="none" playsinline width="1664" height="1080"></video>
    <p class="mono cap">JevBar filling a real internship application from one spoken sentence · 1 min 14 s</p>
  </div>
  <div class="demo-body grid">
    <div class="try">
      <p class="label">Try to get something past it</p>
      <form id="jb-form" class="try-form">
        <select id="jb-verb" aria-label="Action">
          <option value="click">click</option>
          <option value="typeText">type into</option>
        </select>
        <input id="jb-name" value="Submit application" aria-label="Control name" autocomplete="off" />
        <select id="jb-task" aria-label="Task">
          <option value="jobApplication">in an application</option>
          <option value="general">anywhere</option>
        </select>
        <button class="btn primary" type="submit">Check</button>
      </form>
      <p class="verdict mono" id="jb-verdict" aria-live="polite"></p>
      <p class="mono tip">Try “Resend code”, “Next”, “Post comment” or a password field.</p>
    </div>
    <div class="cases">
      <div class="cases-head">
        <p class="label">Test cases</p>
        <button class="btn" type="button" id="jb-run" data-agent-play>Run them</button>
      </div>
      <table class="mono" id="jb-table">
        <tbody>
          {
            cases.map((c) => (
              <tr data-verb={c.verb} data-name={c.name} data-task={c.task}>
                <td>{c.verb === 'click' ? 'click' : 'type into'} “{c.name}”</td>
                <td class="res">–</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
  <p class="demo-note">
    A line-for-line port of Policy.swift. Whole phrases are matched against the control’s own words, so “Resend code”
    is not mistaken for “Send”, and “Next” and “Save draft” stay allowed, or no multi-page form could be filled.
  </p>
</div>

<script>
  import { authorize, type Verb, type TaskKind } from '../../scripts/policy';
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  function check(verb: Verb, name: string, task: TaskKind) {
    return authorize({ verb, controlName: name }, task);
  }

  $('jb-form').addEventListener('submit', (e) => {
    e.preventDefault();
    verdict();
  });
  function verdict() {
    const d = check($<HTMLSelectElement>('jb-verb').value as Verb, $<HTMLInputElement>('jb-name').value, $<HTMLSelectElement>('jb-task').value as TaskKind);
    const v = $('jb-verdict');
    v.className = `verdict mono ${d.allow ? 'ok' : 'bad'}`;
    v.textContent = d.allow ? '✓ allowed' : `⊘ refused: ${d.reason}`;
  }
  verdict();

  $('jb-run').addEventListener('click', async () => {
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('#jb-table tr')];
    rows.forEach((r) => (r.querySelector('.res')!.textContent = '–'));
    for (const r of rows) {
      await new Promise((res) => setTimeout(res, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 280));
      const d = check(r.dataset.verb as Verb, r.dataset.name!, r.dataset.task as TaskKind);
      const cell = r.querySelector<HTMLElement>('.res')!;
      cell.className = `res ${d.allow ? 'ok' : 'bad'}`;
      cell.textContent = d.allow ? '✓ allowed' : '⊘ refused';
      cell.title = d.allow ? '' : d.reason;
    }
  });
</script>

<style>
  .sig {
    font-family: var(--mono);
  }
  .video {
    padding: clamp(16px, 3vw, 28px) clamp(16px, 3vw, 28px) 0;
  }
  video {
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #000;
  }
  .cap {
    font-size: 12px;
    color: var(--faint);
    margin: 10px 0 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(20px, 4vw, 48px);
  }
  .label {
    margin: 0 0 12px;
  }
  .try-form {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 8px;
  }
  .try-form input,
  .try-form select {
    border: 1px solid var(--line-2);
    border-radius: 8px;
    background: var(--bg);
    padding: 9px 10px;
    font-family: var(--mono);
    font-size: 13px;
    min-width: 0;
  }
  .try-form .btn {
    height: auto;
    justify-content: center;
  }
  .verdict {
    font-size: 13px;
    line-height: 1.55;
    margin: 14px 0 8px;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid var(--line-2);
    background: var(--bg);
  }
  .verdict.ok {
    border-color: color-mix(in srgb, var(--ok) 50%, var(--line-2));
  }
  .verdict.bad {
    border-color: color-mix(in srgb, var(--bad) 50%, var(--line-2));
  }
  .tip {
    font-size: 11.5px;
    color: var(--faint);
    margin: 0;
  }
  .cases-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
  }
  .cases-head .label {
    margin: 0;
  }
  .cases-head .btn {
    height: 34px;
    font-size: 12px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
  }
  td {
    padding: 8px 0;
    border-top: 1px solid var(--line);
  }
  td.res {
    text-align: right;
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
