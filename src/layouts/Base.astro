---
// Fonts are served from this site, so no visitor's request goes to a third party.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import '../styles/agent.css';

interface Props {
  title?: string;
  description?: string;
  page: 'home' | 'project' | 'cv';
  slug?: string;
}
const { title, description, page, slug } = Astro.props;
const fullTitle = title ? `${title} · Jazil Imran` : 'Jazil Imran';
const desc =
  description ??
  'Computer Science at the University of Cambridge. I build agents that do real work, and know exactly when to stop.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const suggestions = [
  'Show me the security project',
  'What did he build with Google DeepMind?',
  "I'm Sam from Google, draft an internship enquiry",
  'Where does he study?',
  'Now press send',
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0b0d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
      // Shortcut labels follow the device: ⌘ on Apple, Ctrl elsewhere, none on touch.
      const apple = /Mac|iPhone|iPad|iPod/.test(navigator.userAgentData?.platform || navigator.platform || navigator.userAgent);
      document.documentElement.dataset.keys = matchMedia('(hover: none) and (pointer: coarse)').matches ? 'touch' : apple ? 'mac' : 'pc';
    </script>
  </head>
  <body data-page={page} data-slug={slug}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Jazil Imran, home"><span class="brand-dot"></span>Jazil Imran</a>
        <nav class="nav" aria-label="Main">
          <a href="/#work">Work</a>
          <a href="/#log">Log</a>
          <a href="/cv/" data-agent-cv aria-current={page === 'cv' ? 'page' : undefined}>CV</a>
          <a href="/#contact">Contact</a>
        </nav>
        <button class="ask-btn" type="button" data-agent-open aria-label="Ask this site">
          Ask this site <kbd data-kbd="open">⌘K</kbd>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Jazil Imran · Built by hand. No trackers.</span>
        <span class="rtt" id="rtt" hidden></span>
        <span>
          <a href="https://github.com/jxzxl07">GitHub</a> ·
          <a href="https://www.linkedin.com/in/jazilimran/">LinkedIn</a> ·
          <a href="mailto:ji297@cam.ac.uk">Email</a>
        </span>
      </div>
    </footer>

    <button class="ask-fab" type="button" data-agent-open aria-label="Ask this site">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 2.5 20 11l-7 1.8L9.6 20z" fill="currentColor"></path></svg>
      Ask
    </button>

    <!-- The agent. Decorative layers are hidden from assistive tech; the log is announced. -->
    <div id="agent-scan" aria-hidden="true"></div>
    <div id="agent-hl" aria-hidden="true"><span class="hl-label"></span></div>
    <div id="agent-cursor" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 2.5 20 11l-7 1.8L9.6 20z" fill="var(--agent)" stroke="var(--agent-ink)" stroke-width="1.2" stroke-linejoin="round"></path></svg>
      <span class="tag">agent</span>
    </div>

    <div id="agent-bar" hidden>
      <div class="bar-panel" role="dialog" aria-modal="true" aria-label="Ask this site">
        <form id="agent-form">
          <input id="agent-input" type="text" autocomplete="off" placeholder="Tell this page what you want" aria-label="What do you want to do?" />
          <button class="mic" id="agent-mic" type="button" aria-label="Talk instead">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg>
          </button>
        </form>
        <p class="bar-hint label">Try</p>
        <ul class="bar-suggest">
          {suggestions.map((s) => <li><button type="button" data-ask={s}>{s}</button></li>)}
        </ul>
        <div class="bar-foot">
          <span class="kb-only"><kbd>↵</kbd> run</span>
          <span class="kb-only">hold <kbd data-kbd="talk">⌘⇧Space</kbd> to talk</span>
          <span class="kb-only"><kbd>esc</kbd> close</span>
          <span id="agent-voice-note" hidden>Voice isn’t available in this browser. Type instead.</span>
        </div>
      </div>
    </div>

    <aside id="agent-log" aria-live="polite" aria-label="What the agent did" hidden>
      <div class="log-head">agent log<button id="agent-log-close" type="button" aria-label="Close log">×</button></div>
      <ol></ol>
    </aside>

    <script>
      import '../scripts/agent';

      // A refresh starts at the top, and section links don't stick to the URL,
      // so reloading never drops you back into the middle of the page.
      history.scrollRestoration = 'manual';
      const navEntry = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      const clean = () => history.replaceState(history.state, '', location.pathname + location.search);
      if (navEntry?.type === 'reload') {
        if (location.hash) clean();
        scrollTo(0, 0);
      } else if (location.hash) {
        const target = document.getElementById(location.hash.slice(1));
        requestAnimationFrame(() => {
          target?.scrollIntoView();
          clean();
        });
      }
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href*="#"]');
        if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey) return;
        const url = new URL(a.href);
        if (url.pathname !== location.pathname || !url.hash) return;
        const target = document.getElementById(url.hash.slice(1));
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
      // How long this page took to come back to you, straight from the browser's own timing.
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      const el = document.getElementById('rtt');
      if (nav && el && nav.responseStart > 0) {
        const rtt = Math.round(nav.responseStart - nav.requestStart);
        if (rtt > 0) {
          el.innerHTML = `Your request reached this page in <b>${rtt} ms</b>`;
          el.hidden = false;
        }
      }
    </script>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 16px;
        top: 12px;
        z-index: 200;
        background: var(--text);
        color: var(--bg);
        padding: 8px 12px;
        border-radius: 6px;
        font-family: var(--mono);
        font-size: 13px;
      }
    </style>
  </body>
</html>
