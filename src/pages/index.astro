---
import Base from '../layouts/Base.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import { projects } from '../data/projects';

const chips = [
  'Show me the security project',
  'What did he build with Google DeepMind?',
  "I'm Sam from Google, draft an internship enquiry",
];

// Months come from each repo's history.
const log: { when: string; kind: string; what: string; href?: string }[] = [
  { when: 'Sep 2026', kind: 'project', what: 'JevBar, a macOS agent that fills forms completely and never submits them', href: '/work/jevbar/' },
  { when: 'Sep 2026', kind: 'hackathon', what: 'NightWatch at the {Tech: Europe} Agentic AI Hack × Google DeepMind', href: '/work/nightwatch/' },
  { when: 'Sep 2026', kind: 'project', what: 'Encrypta 2.0: end-to-end encryption between people anywhere, not just on one LAN', href: '/work/encrypta/' },
  { when: 'Jul 2026', kind: 'project', what: 'Tripos Tutor: examiner-style marking for 230+ Cambridge past-paper questions', href: '/work/tripos-tutor/' },
  { when: 'Jul 2026', kind: 'project', what: 'Routing Protocol Simulator, the tool I wished I’d had when teaching routing loops', href: '/work/routing/' },
  { when: 'Jun 2026', kind: 'project', what: 'CreaseLab, and throwing out a model that scored well for the wrong reasons', href: '/work/creaselab/' },
  { when: 'Oct 2025', kind: 'education', what: 'Started Computer Science at Cambridge, Gonville & Caius College' },
  { when: 'Aug 2025', kind: 'education', what: 'A*A*A*A* at A-level: Maths, Further Maths, Computer Science, Physics' },
  { when: 'Jul 2024', kind: 'work', what: 'Work shadowing with Hudl’s software and data engineering teams' },
  { when: 'Jun 2022', kind: 'work', what: 'Networking Instructor at Invirtigo: two years teaching CCNA to 20+ students' },
];
---

<Base page="home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-main">
        <p class="label hero-kicker reveal-now" style="--d:0">Computer Science · University of Cambridge</p>
        <h1 class="reveal-now" style="--d:1">
          <span>I build software</span>
          <span>that acts on its own,</span>
          <em>and the guardrails</em>
          <em>that make it safe to.</em>
        </h1>
        <p class="lede reveal-now" style="--d:2">
          I’m Jazil, a Computer Science student at Gonville &amp; Caius, Cambridge. My projects click, type, repair
          and mark, and each one is built around a list of things it must never do.
        </p>

        <div class="ask reveal-now" style="--d:3">
          <form class="ask-field" data-agent-inline id="hero-ask">
            <span class="ask-caret" aria-hidden="true">›</span>
            <input type="text" autocomplete="off" aria-label="Tell this page what you want" placeholder="Show me the cricket project" />
            <button class="mic" type="button" data-agent-mic aria-label="Talk instead">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg>
            </button>
            <button class="ask-go" type="submit">Run <kbd>↵</kbd></button>
          </form>
          <p class="ask-lead mono">
            This page has an agent built in. Tell it what you want<span class="desk-only">, or hold <kbd>⌘⇧Space</kbd> and say it</span>.
            It acts in front of you, and it won’t press send.
          </p>
          <div class="ask-chips">
            {chips.map((c) => <button class="chip" type="button" data-ask={c}>{c}</button>)}
          </div>
        </div>
      </div>

      <aside class="inspector reveal-now" style="--d:4" aria-label="What the agent can see on this page">
        <div class="insp-head mono">
          <span class="dot"></span>
          <span>what the agent sees</span>
          <span class="insp-count" id="agent-status">reading…</span>
        </div>
        <ol class="insp-list mono" id="insp-list"></ol>
        <p class="insp-foot mono">
          Every named control on this page, read the way JevBar reads a Mac: role, then name. Click one and the agent
          goes there.
        </p>
      </aside>
    </div>

    <div class="wrap now reveal-now" style="--d:5">
      <p class="mono">
        <span class="now-dot"></span><b>Now</b> Building JevBar · starting my second year at Cambridge in October ·
        open to internships for summer 2027
      </p>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="label">Work</p>
          <h2 id="work-h">Six things I’ve built, and what each one refuses to do.</h2>
        </div>
      </div>
      <ol class="work">
        {
          projects.map((p) => (
            <li class="reveal">
              <a href={`/work/${p.slug}/`} class="row" data-agent-project={p.slug} aria-label={p.name}>
                <span class="row-i mono">{p.index}</span>
                <span class="row-main">
                  <span class="row-kind label">
                    {p.kind}
                    {p.context && <span class="row-ctx"> · hackathon</span>}
                  </span>
                  <span class="row-name" style={`view-transition-name: vt-${p.slug}`}>
                    {p.name}
                  </span>
                  <span class="row-sum">{p.summary}</span>
                  <span class="row-stat">
                    <span class="row-v mono">{p.headline.value}</span>
                    <span class="row-l">{p.headline.label}</span>
                  </span>
                </span>
                <span class="row-pv">
                  <ProjectPreview slug={p.slug} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="log" aria-labelledby="log-h">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="label">Log</p>
          <h2 id="log-h">Four years, most recent first.</h2>
        </div>
      </div>
      <ol class="log mono">
        {
          log.map((l) => (
            <li class="reveal">
              <span class="log-when">{l.when}</span>
              <span class={`log-kind k-${l.kind}`}>{l.kind}</span>
              {l.href ? (
                <a class="log-what" href={l.href}>
                  {l.what}
                </a>
              ) : (
                <span class="log-what">{l.what}</span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-h">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="label">About</p>
          <h2 id="about-h">I taught networks, then learned to build on top of them.</h2>
        </div>
      </div>
      <div class="about">
        <div class="about-prose reveal">
          <p>
            Before university I spent two years teaching CCNA to more than twenty students: subnetting, VLANs,
            routing protocols, and the moment a traceroute finally makes sense. Explaining how a system fails turned
            out to be the best way to learn how to build one.
          </p>
          <p>
            Now I read Computer Science at Cambridge, and most of what I build takes action: agents that fill forms,
            repair services and mark exam answers. The action is rarely the hard part. The hard part is everything
            around it: what the agent may touch, how it proves it worked, and when it has to stop and hand back to a
            person.
          </p>
          <p>Off the keyboard it’s cricket. I captained my school side, which is partly why CreaseLab exists.</p>
        </div>
        <dl class="facts reveal">
          <div id="education">
            <dt class="label">Education</dt>
            <dd>
              <b>University of Cambridge</b>, Gonville &amp; Caius College
              <span class="muted">BA Computer Science · 2025–2028</span>
            </dd>
            <dd>
              <b>Southend High School for Boys</b>
              <span class="muted">A-levels A*A*A*A*: Maths, Further Maths, Computer Science, Physics</span>
            </dd>
          </div>
          <div id="experience">
            <dt class="label">Experience</dt>
            <dd>
              <b>Networking Instructor</b>, Invirtigo
              <span class="muted">2022–2024 · CCNA teaching for 20+ students</span>
            </dd>
            <dd>
              <b>Technology work shadowing</b>, Hudl
              <span class="muted">2024 · software and data engineering for sports video</span>
            </dd>
          </div>
          <div id="skills">
            <dt class="label">Tools</dt>
            <dd><span class="k">Languages</span> Python, Java, OCaml, C, SQL, JavaScript, TypeScript, Swift</dd>
            <dd><span class="k">Building with</span> FastAPI, React, WebCrypto, WebRTC, OpenCV, MediaPipe, Gemini</dd>
            <dd><span class="k">Shipping with</span> Docker, GitHub Actions, PostgreSQL, Modal, Render, Linux</dd>
          </div>
          <div>
            <dt class="label">Also</dt>
            <dd>Academic Achievement Prize, Computer Science Prize, Senior Maths Challenge Gold, cricket team captain</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <div class="section-head reveal">
        <div>
          <p class="label">Contact</p>
          <h2 id="contact-h">Internships, collaborations, or a question about something here.</h2>
        </div>
      </div>
      <div class="contact">
        <div class="contact-side reveal">
          <p class="big-email">
            <a class="email" href="mailto:ji297@cam.ac.uk">ji297@cam.ac.uk</a>
            <button class="chip copy" type="button" id="copy-email">Copy</button>
          </p>
          <p class="muted">
            Or let the agent draft it. Tell it who you are and what you want, and it fills in this form in front of
            you, then stops. Sending is always your call.
          </p>
          <button class="chip" type="button" data-ask="I'm a recruiter, draft an internship enquiry">
            Draft an internship enquiry
          </button>
          <p class="links mono">
            <a href="https://github.com/jxzxl07">github.com/jxzxl07 ↗</a><br />
            <a href="https://www.linkedin.com/in/jazilimran/">linkedin.com/in/jazilimran ↗</a><br />
            <a href="/cv/">CV, on one page →</a>
          </p>
        </div>
        <form id="contact-form" class="form reveal" aria-label="Contact" novalidate>
          <div class="field">
            <label for="cf-name">Your name</label>
            <input id="cf-name" name="name" autocomplete="name" />
          </div>
          <div class="field">
            <label for="cf-email">Your email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" />
          </div>
          <div class="field">
            <label for="cf-reason">Reason</label>
            <select id="cf-reason" name="reason">
              <option>Internship</option>
              <option>Role</option>
              <option>Collaboration</option>
              <option selected>Question</option>
            </select>
          </div>
          <div class="field">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" rows="5"></textarea>
          </div>
          <div class="form-foot">
            <button class="btn primary" type="submit" data-agent-send>Send via your mail app</button>
            <span class="mono muted small">Opens your email client. Nothing is stored here.</span>
          </div>
          <div id="contact-report" class="report" role="status" hidden></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const subject = `${d.get('reason')}${d.get('name') ? ` from ${d.get('name')}` : ''}`;
    const body = `${d.get('message') ?? ''}\n\n${d.get('name') ?? ''}${d.get('email') ? `\n${d.get('email')}` : ''}`;
    location.href = `mailto:ji297@cam.ac.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  const copy = document.getElementById('copy-email')!;
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('ji297@cam.ac.uk');
      copy.textContent = 'Copied';
    } catch {
      copy.textContent = 'Select it instead';
    }
    setTimeout(() => (copy.textContent = 'Copy'), 1800);
  });

  // Cycle the placeholder through real commands, so the field teaches itself.
  const input = document.querySelector<HTMLInputElement>('#hero-ask input');
  const examples = ['Show me the cricket project', 'Where does he study?', 'Open NightWatch and run the demo', 'Switch to light mode', 'Type my password'];
  let i = 0;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (input && !reduced) {
    setInterval(() => {
      if (document.activeElement === input || input.value) return;
      i = (i + 1) % examples.length;
      input.placeholder = examples[i];
    }, 3200);
  }

  // Reveal on scroll, and only animate project previews while they're on screen.
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        e.target.classList.toggle('inview', e.isIntersecting);
        if (e.isIntersecting) e.target.classList.add('shown');
      }
    },
    { rootMargin: '0px 0px -8% 0px' },
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding: clamp(56px, 10vw, 120px) 0 clamp(40px, 6vw, 72px);
    position: relative;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .hero-kicker {
    margin: 0 0 28px;
  }
  h1 {
    font-weight: 380;
    font-size: clamp(38px, 5.6vw, 80px);
    line-height: 1.02;
    letter-spacing: -0.028em;
    margin: 0;
  }
  h1 span,
  h1 em {
    display: block;
  }
  h1 em {
    font-style: italic;
    color: var(--muted);
    font-weight: 300;
  }
  .lede {
    max-width: 34em;
    margin: 28px 0 0;
    font-size: clamp(19px, 1.5vw, 21px);
    color: var(--muted);
    text-wrap: pretty;
  }
  .reveal-now {
    animation: rise-in 0.9s var(--ease) both;
    animation-delay: calc(var(--d) * 90ms + 100ms);
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(14px);
      filter: blur(4px);
    }
  }
  .ask {
    margin-top: 44px;
    max-width: 680px;
  }
  .ask-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 8px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--bg-2);
    transition: border-color 0.2s, box-shadow 0.2s;
    box-shadow: 0 0 0 0 var(--agent-dim);
    animation: glow 3.2s ease-in-out 1.6s 2;
  }
  @keyframes glow {
    50% {
      box-shadow: 0 0 0 6px var(--agent-dim);
      border-color: var(--agent);
    }
  }
  .ask-field:focus-within {
    border-color: var(--agent);
    box-shadow: 0 0 0 4px var(--agent-dim);
  }
  .ask-caret {
    font-family: var(--mono);
    color: var(--agent);
    font-size: 20px;
  }
  .ask-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 21px;
    padding: 8px 0;
  }
  .ask-field input::placeholder {
    color: var(--faint);
  }
  .ask-go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 13px;
    cursor: pointer;
  }
  .ask-go kbd {
    background: transparent;
    border-color: color-mix(in srgb, var(--bg) 40%, transparent);
    color: var(--bg);
  }
  .ask-lead {
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--muted);
    margin: 14px 0 12px;
  }
  .ask-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* The inspector: the page as the agent reads it */
  .inspector {
    position: sticky;
    top: 84px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--bg-2);
    overflow: hidden;
    margin-top: 44px;
  }
  .insp-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    font-size: 11.5px;
    color: var(--muted);
  }
  .insp-head .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--agent);
    box-shadow: 0 0 0 3px var(--agent-dim);
  }
  .insp-count {
    margin-left: auto;
    color: var(--faint);
  }
  :global(.insp-count b) {
    color: var(--text);
    font-weight: 500;
  }
  .insp-list {
    list-style: none;
    margin: 0;
    padding: 14px 0 6px;
    height: 330px;
    overflow: auto;
    font-size: 11.5px;
    scrollbar-width: thin;
    mask-image: linear-gradient(transparent, #000 4%, #000 88%, transparent);
  }
  :global(.insp-list li) {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 8px;
    padding: 3px 12px;
    cursor: pointer;
    color: var(--faint);
    white-space: nowrap;
    transition: color 0.2s, background 0.2s;
  }
  :global(.insp-list li .n) {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--muted);
  }
  :global(.insp-list li.lvl-2) {
    padding-left: 24px;
  }
  :global(.insp-list li.in) {
    color: var(--agent);
  }
  :global(.insp-list li.in .n) {
    color: var(--text);
  }
  :global(.insp-list li:hover) {
    background: var(--bg-3);
  }
  :global(.insp-list li.new) {
    animation: blip 0.5s var(--ease);
  }
  @keyframes blip {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
  }
  .insp-foot {
    margin: 0;
    padding: 10px 12px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    line-height: 1.55;
    color: var(--faint);
  }
  .now {
    margin-top: clamp(40px, 6vw, 72px);
  }
  .now p {
    margin: 0;
    padding: 14px 18px;
    border: 1px solid var(--line-2);
    border-radius: 10px;
    background: var(--bg-2);
    font-size: 13.5px;
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }
  .now b {
    color: var(--text);
    font-weight: 500;
  }
  .now-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--ok) 20%, transparent);
    }
  }
  .inspector {
    min-width: 0;
  }
  @media (hover: none) {
    .desk-only {
      display: none;
    }
  }
  @media (max-width: 1040px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .inspector {
      position: static;
      margin-top: 0;
    }
    .insp-list {
      height: 200px;
    }
  }
  @media (max-width: 720px) {
    .insp-list,
    .insp-foot {
      display: none;
    }
  }

  /* ---------- Section heads ---------- */
  .section-head {
    margin-bottom: 56px;
  }
  .section-head .label {
    margin: 0 0 10px;
  }
  .section-head h2 {
    font-weight: 400;
    font-size: clamp(32px, 4.4vw, 54px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
  }

  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);
  }
  :global(.reveal.shown) {
    opacity: 1;
    transform: none;
  }

  /* ---------- Work ---------- */
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(280px, 380px);
    gap: clamp(20px, 4vw, 56px);
    align-items: center;
    padding: 36px 16px;
    margin: 0 -16px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    border-radius: 6px;
    transition: background 0.3s;
  }
  .row:hover {
    background: var(--bg-2);
  }
  .row-i {
    align-self: start;
    color: var(--faint);
    padding-top: 30px;
  }
  .row-main {
    display: grid;
    gap: 8px;
  }
  .row-ctx {
    color: var(--text);
  }
  .row-name {
    font-size: clamp(32px, 4.2vw, 52px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    transition: transform 0.4s var(--ease);
    width: fit-content;
  }
  .row:hover .row-name {
    transform: translateX(6px);
  }
  .row-sum {
    color: var(--muted);
    max-width: 38em;
    font-size: 17px;
  }
  .row-stat {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 8px;
  }
  .row-v {
    font-size: 17px;
    color: var(--text);
  }
  .row-l {
    font-size: 14px;
    color: var(--faint);
  }
  .row-pv {
    transition: transform 0.5s var(--ease);
  }
  .row:hover .row-pv {
    transform: scale(1.03) rotate(-0.6deg);
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: 36px 1fr;
      gap: 12px 16px;
    }
    .row-i {
      padding-top: 6px;
    }
    .row-pv {
      grid-column: 2;
      max-width: 360px;
    }
  }

  /* ---------- Log ---------- */
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 13px;
    border-left: 1px solid var(--line-2);
    margin-left: 6px;
  }
  .log li {
    display: grid;
    grid-template-columns: 80px 96px 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0 12px 24px;
    position: relative;
  }
  .log li::before {
    content: '';
