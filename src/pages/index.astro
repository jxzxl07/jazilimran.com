---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';

const chips = [
  'Show me the security project',
  'What did he build with Google DeepMind?',
  "I'm Sam from Google, draft an internship enquiry",
];
---

<Base page="home">
  <section class="hero">
    <div class="wrap">
      <p class="label hero-kicker">Computer Science · University of Cambridge</p>
      <h1>
        I build software that acts on its own, <em>and the guardrails that make it safe to.</em>
      </h1>
      <p class="lede">
        I’m Jazil, a second-year at Gonville &amp; Caius. My projects are agents that do real work on real
        screens and services, and I spend as long on what they must never do as on what they can.
      </p>

      <div class="ask">
        <p class="ask-lead">
          This page has an agent built in. Tell it what you want and watch it act. It won’t press send.
        </p>
        <form class="ask-field" data-agent-inline>
          <span class="ask-caret" aria-hidden="true">›</span>
          <input type="text" autocomplete="off" aria-label="Tell this page what you want" placeholder="Show me the cricket project" />
          <button class="mic" type="button" data-agent-mic aria-label="Talk instead">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg>
          </button>
          <button class="ask-go" type="submit">Run <kbd>↵</kbd></button>
        </form>
        <div class="ask-chips">
          {chips.map((c) => <button class="chip" type="button" data-ask={c}>{c}</button>)}
        </div>
        <p class="ask-status mono" id="agent-status">Reading this page…</p>
      </div>
    </div>
  </section>

  <section class="section" id="work" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head">
        <span class="label">01 — Work</span>
        <h2 id="work-h">Six things I’ve built, and what each one refuses to do.</h2>
      </div>
      <ol class="work">
        {
          projects.map((p) => (
            <li>
              <a href={`/work/${p.slug}/`} class="row" data-agent-project={p.slug} aria-label={p.name}>
                <span class="row-i mono">{p.index}</span>
                <span class="row-main">
                  <span class="row-name" style={`view-transition-name: vt-${p.slug}`}>{p.name}</span>
                  <span class="row-kind label">{p.kind}</span>
                  <span class="row-sum">{p.summary}</span>
                </span>
                <span class="row-stat">
                  <span class="row-v mono">{p.headline.value}</span>
                  <span class="row-l">{p.headline.label}</span>
                </span>
                <span class="row-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-h">
    <div class="wrap">
      <div class="section-head">
        <span class="label">02 — About</span>
        <h2 id="about-h">Taught networks, then learned to build on top of them.</h2>
      </div>
      <div class="about">
        <div class="about-prose">
          <p>
            I started out teaching. For two years I ran CCNA lessons for more than twenty students: subnetting,
            VLANs, routing protocols, and the moment a traceroute finally makes sense. Explaining how a system
            fails turned out to be the best way to learn how to build one.
          </p>
          <p>
            Now I read Computer Science at Cambridge, and most of what I build is software that takes action:
            agents that fill forms, repair services and mark exam answers. The interesting engineering is rarely
            the action itself. It is the checks around it: what the agent may touch, how it proves it worked, and
            when it must stop and hand back to a person.
          </p>
          <p>Away from the keyboard I play cricket. I captained my school team, which is partly why CreaseLab exists.</p>
        </div>
        <dl class="facts">
          <div id="education">
            <dt class="label">Education</dt>
            <dd>
              <b>University of Cambridge</b>, Gonville &amp; Caius College
              <span class="muted">BA Computer Science · 2025–2028</span>
            </dd>
            <dd>
              <b>Southend High School for Boys</b>
              <span class="muted">A-levels A*A*A*A*: Maths, Further Maths, Computer Science, Physics</span>
            </dd>
          </div>
          <div id="experience">
            <dt class="label">Experience</dt>
            <dd>
              <b>Networking Instructor</b>, Invirtigo
              <span class="muted">2022–2024 · CCNA teaching for 20+ students</span>
            </dd>
            <dd>
              <b>Technology work shadowing</b>, Hudl
              <span class="muted">2024 · software and data engineering for sports video</span>
            </dd>
          </div>
          <div id="skills">
            <dt class="label">Tools</dt>
            <dd>
              <span class="muted">Languages</span> Python, Java, OCaml, C, SQL, JavaScript, TypeScript, Swift
            </dd>
            <dd>
              <span class="muted">Building with</span> FastAPI, React, WebCrypto, WebRTC, OpenCV, MediaPipe, Gemini
            </dd>
            <dd><span class="muted">Shipping with</span> Docker, GitHub Actions, PostgreSQL, Modal, Render, Linux</dd>
          </div>
          <div>
            <dt class="label">Also</dt>
            <dd>
              Academic Achievement Prize, Computer Science Prize, Senior Maths Challenge Gold, cricket team captain
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <div class="section-head">
        <span class="label">03 — Contact</span>
        <h2 id="contact-h">Internships, collaborations, or a question about something here.</h2>
      </div>
      <div class="contact">
        <div class="contact-side">
          <p>
            Email is quickest: <a class="email" href="mailto:ji297@cam.ac.uk">ji297@cam.ac.uk</a>
          </p>
          <p class="muted">
            Or ask the agent to draft a message for you. It will fill in this form in front of you, then stop.
            Sending is always your call.
          </p>
          <button class="chip" type="button" data-ask="I'm a recruiter, draft an internship enquiry">
            Draft an internship enquiry
          </button>
          <p class="links mono">
            <a href="https://github.com/jxzxl07">github.com/jxzxl07</a><br />
            <a href="https://www.linkedin.com/in/jazilimran/">linkedin.com/in/jazilimran</a>
          </p>
        </div>
        <form id="contact-form" class="form" aria-label="Contact" novalidate>
          <div class="field">
            <label for="cf-name">Your name</label>
            <input id="cf-name" name="name" autocomplete="name" />
          </div>
          <div class="field">
            <label for="cf-email">Your email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" />
          </div>
          <div class="field">
            <label for="cf-reason">Reason</label>
            <select id="cf-reason" name="reason">
              <option>Internship</option>
              <option>Role</option>
              <option>Collaboration</option>
              <option selected>Question</option>
            </select>
          </div>
          <div class="field">
            <label for="cf-message">Message</label>
            <textarea id="cf-message" name="message" rows="5"></textarea>
          </div>
          <div class="form-foot">
            <button class="btn primary" type="submit" data-agent-send>Send via your mail app</button>
            <span class="mono muted small">Opens your email client. Nothing is stored here.</span>
          </div>
          <div id="contact-report" class="report" role="status" hidden></div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const subject = `${d.get('reason')}${d.get('name') ? ` from ${d.get('name')}` : ''}`;
    const body = `${d.get('message') ?? ''}\n\n${d.get('name') ?? ''}${d.get('email') ? `\n${d.get('email')}` : ''}`;
    location.href = `mailto:ji297@cam.ac.uk?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });

  // Cycle the placeholder through real commands, so the field teaches itself.
  const input = document.querySelector<HTMLInputElement>('[data-agent-inline] input');
  const examples = ['Show me the cricket project', 'Where does he study?', 'Open NightWatch and run the demo', 'Switch to light mode', 'Type my password'];
  let i = 0;
  if (input && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => {
      if (document.activeElement === input || input.value) return;
      i = (i + 1) % examples.length;
      input.placeholder = examples[i];
    }, 3200);
  }
</script>

<style>
  .hero {
    padding: clamp(64px, 12vw, 150px) 0 clamp(72px, 10vw, 120px);
  }
  .hero-kicker {
    margin: 0 0 28px;
  }
  h1 {
    font-weight: 380;
    font-size: clamp(40px, 7vw, 92px);
    line-height: 1.02;
    letter-spacing: -0.028em;
    margin: 0;
    max-width: 15ch;
    text-wrap: balance;
  }
  h1 em {
    font-style: italic;
    color: var(--muted);
    font-weight: 300;
  }
  .lede {
    max-width: 38em;
    margin: 32px 0 0;
    font-size: clamp(19px, 1.6vw, 22px);
    color: var(--muted);
    text-wrap: pretty;
  }
  .ask {
    margin-top: 56px;
    max-width: 760px;
  }
  .ask-lead {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .ask-field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 8px 16px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: var(--bg-2);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ask-field:focus-within {
    border-color: var(--agent);
    box-shadow: 0 0 0 4px var(--agent-dim);
  }
  .ask-caret {
    font-family: var(--mono);
    color: var(--agent);
    font-size: 20px;
  }
  .ask-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 21px;
    padding: 8px 0;
  }
  .ask-field input::placeholder {
    color: var(--faint);
  }
  .ask-go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 12px;
    border: 0;
    border-radius: 8px;
    background: var(--text);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 13px;
    cursor: pointer;
  }
  .ask-go kbd {
    background: transparent;
    border-color: color-mix(in srgb, var(--bg) 40%, transparent);
    color: var(--bg);
  }
  .ask-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .ask-status {
    margin: 20px 0 0;
    color: var(--faint);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ask-status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--agent);
  }
  :global(.ask-status.ready)::before {
    background: var(--agent);
  }
  :global(.ask-status b) {
    color: var(--text);
    font-weight: 500;
  }

  /* Work list */
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: 56px 1fr 220px 24px;
    gap: 24px;
    align-items: start;
    padding: 30px 12px;
    margin: 0 -12px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.25s;
  }
  .row:hover {
    background: var(--bg-2);
  }
  .row-i {
    color: var(--faint);
    padding-top: 10px;
  }
  .row-main {
    display: grid;
    gap: 6px;
  }
  .row-name {
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .row-sum {
    color: var(--muted);
    max-width: 44em;
    font-size: 17px;
    margin-top: 4px;
  }
  .row-stat {
    display: grid;
    gap: 4px;
    padding-top: 10px;
  }
  .row-v {
    font-size: 20px;
  }
  .row-l {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.35;
  }
  .row-go {
    padding-top: 10px;
    color: var(--faint);
    transition: transform 0.25s var(--ease), color 0.25s;
  }
  .row:hover .row-go {
    transform: translateX(4px);
    color: var(--text);
  }
  @media (max-width: 860px) {
    .row {
      grid-template-columns: 40px 1fr;
      gap: 12px;
    }
    .row-stat {
      grid-column: 2;
      padding-top: 4px;
    }
    .row-go {
      display: none;
    }
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
  }
  .about-prose p {
    margin: 0 0 1.1em;
    text-wrap: pretty;
  }
  .facts {
    margin: 0;
    display: grid;
    gap: 28px;
  }
  .facts dt {
    margin-bottom: 8px;
  }
  .facts dd {
    margin: 0 0 12px;
    font-size: 17px;
    line-height: 1.45;
  }
  .facts dd b {
    font-weight: 500;
  }
  .facts dd .muted {
    display: block;
    font-size: 15px;
  }
  #skills dd .muted {
    display: inline;
    font-family: var(--mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: 6px;
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .contact-side p {
    margin: 0 0 1em;
  }
  .email {
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }
  .links {
    margin-top: 28px !important;
    font-size: 13px;
    line-height: 2;
  }
  .links a {
    color: var(--muted);
  }
  .form {
    display: grid;
    gap: 16px;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: var(--bg-2);
  }
  .field {
    display: grid;
    gap: 6px;
  }
  .field label {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: 1px solid var(--line-2);
    border-radius: 8px;
    background: var(--bg);
    padding: 10px 12px;
    font-size: 17px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field textarea {
    resize: vertical;
    line-height: 1.5;
  }
  .field :focus {
    outline: 0;
    border-color: var(--text);
  }
  .form-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .small {
    font-size: 11.5px;
  }
  .report {
    border: 1px solid var(--agent);
    border-radius: 10px;
    padding: 12px 14px;
    background: var(--agent-dim);
    font-size: 16px;
  }
  :global(.report p) {
    margin: 0 0 4px;
  }
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>
